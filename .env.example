# 印·Yinor 配置模板 —— 复制为 .env 后填写
# .env 与 .env.example 均已进 .gitignore（防 key 泄漏），只提交本模板

# ── LLM 端点（必填）──────────────────────────────────────────
# OpenAI 兼容端点（/v1 结尾）。默认指向本机 cyRouter，
# 换机器/云服务时改成实际地址，例如 https://api.deepseek.com/v1
#YINOR_LLM_BASE_URL=http://127.0.0.1:20100/v1

# API Key（必填，无默认值）
CYROUTER_API_KEY=sk-xxxxxxxx

# 提取/对话模型（默认 auto，即跟随路由；直连服务时填具体模型名）
#YINOR_LLM_MODEL=deepseek-v4-flash

# ── Embedding（换模型时注意维度必须匹配）────────────────────
#YINOR_EMBED_MODEL=text-embedding-v3
#YINOR_EMBED_DIM=1024

# ── 服务（可选，均有默认值）─────────────────────────────────
# 数据库路径（默认 <项目根>/data/yinor.db）
#YINOR_DB_PATH=data/yinor.db
# 监听端口（默认 20102；改端口需同步 pi 扩展的 YINOR_URL）
#YINOR_PORT=20102
