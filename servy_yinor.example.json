{
  "Name": "yinor",
  "DisplayName": "yinor Memory System",
  "Description": "yinor 自研记忆系统（SQLite+FTS5 时序知识图谱 + FastAPI，供 pi 扩展调用）",
  "ExecutablePath": "C:\\path\\to\\yinor\\.venv\\Scripts\\python.exe",
  "StartupDirectory": "C:\\path\\to\\yinor",
  "Parameters": "run_server.py",
  "StartupType": 2,
  "Priority": 2,
  "StdoutPath": "C:\\path\\to\\yinor\\logs\\yinor-out.log",
  "StderrPath": "C:\\path\\to\\yinor\\logs\\yinor-err.log",
  "EnableRotation": true,
  "RotationSize": 10,
  "EnableDateRotation": false,
  "DateRotationType": 0,
  "MaxRotations": 0,
  "EnableHealthMonitoring": true,
  "HeartbeatInterval": 30,
  "MaxFailedChecks": 3,
  "RecoveryAction": 1,
  "MaxRestartAttempts": 20,
  "ServiceDependencies": "",
  "RunAsLocalSystem": true,
  "PreLaunchTimeoutSeconds": 30,
  "PreLaunchRetryAttempts": 0,
  "PreLaunchIgnoreFailure": false,
  "EnableDebugLogs": false,
  "StartTimeout": 10,
  "StopTimeout": 5,
  "PreviousStopTimeout": 5,
  "PreStopTimeoutSeconds": 5,
  "PreStopLogAsError": false
}
